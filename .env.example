# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados do
# seu projeto Supabase: Project Settings → API, no painel do Supabase.
#
# VITE_SUPABASE_ANON_KEY é a chave "anon public" — feita para ser usada
# no navegador (protegida pelas regras de RLS do banco). NUNCA use aqui a
# chave "service_role" (essa sim é secreta).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLIC-AQUI
